# Security headers for every response. Mirrored in netlify.toml [[headers]]
# so the two cannot diverge, same as the redirects.
#
# No Content-Security-Policy yet: every page carries inline scripts (GA4,
# form confirmation) and loads Google Fonts, so a useful CSP needs nonces
# or hashes on each page first. Add it as a deliberate piece of work, not
# a header dropped in here.
#
# HSTS is set without includeSubDomains on purpose: portal. and learn.
# are separate properties and this file cannot vouch for them.

/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000

# Machine-readable copies of the site for AI assistants and feed readers.
# board.md points back to /board as the canonical page. Mirrored in netlify.toml.
/board.md
  Content-Type: text/markdown; charset=utf-8
  Link: <https://catalystgrowthcoach.co.uk/board>; rel="canonical"
/site/board.md
  Content-Type: text/markdown; charset=utf-8
  Link: <https://catalystgrowthcoach.co.uk/board>; rel="canonical"
/llms.txt
  Content-Type: text/plain; charset=utf-8
/llms-full.txt
  Content-Type: text/plain; charset=utf-8
/site/llms.txt
  Content-Type: text/plain; charset=utf-8
/site/llms-full.txt
  Content-Type: text/plain; charset=utf-8
/feed.xml
  Content-Type: application/rss+xml; charset=utf-8
/site/feed.xml
  Content-Type: application/rss+xml; charset=utf-8

# Photos and video can be cached for a day; a replaced image shows within 24
# hours. HTML keeps Netlify's default (always revalidate), so a deploy shows
# straight away.
/images/*
  Cache-Control: public, max-age=86400
/site/images/*
  Cache-Control: public, max-age=86400
/videos/*
  Cache-Control: public, max-age=86400
/site/videos/*
  Cache-Control: public, max-age=86400
