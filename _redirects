# Repository files that live in the publish root but are not site content.
# Netlify serves anything in the publish directory, so they are 404'd here.
# The ! forces the rule even though the file exists.
/.mcp.json                         /404.html  404!
/CLAUDE.md                         /404.html  404!
/netlify.toml                      /404.html  404!
/_headers                          /404.html  404!
/_redirects                        /404.html  404!
/.github/*                         /404.html  404!
/_backup-pre-editorial-rebuild/*   /404.html  404!
/scripts/*                         /404.html  404!
/data/*                            /404.html  404!
/netlify/*                         /404.html  404!
/package.json                      /404.html  404!
/package-lock.json                 /404.html  404!
/node_modules/*                    /404.html  404!

# TeamStrong's two pages for each kind of leadership team, and their plain
# Markdown copies. The files sit flat beside teamstrong.html so /teamstrong
# is never mistaken for a folder. 200 = served at the pretty address.
/teamstrong/one-team       /teamstrong-one-team.html  200
/teamstrong/leaders        /teamstrong-leaders.html   200
/teamstrong/one-team.md    /teamstrong-one-team.md    200
/teamstrong/leaders.md     /teamstrong-leaders.md     200
